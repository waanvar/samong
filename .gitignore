/target
.brain/
node_modules/
web/dist/*
!web/dist/.gitkeep
.demo/
# Local Claude Code state stays out; the shared settings file is committed so
# cloud sessions get the same permissions as a laptop, and the hooks it points at
# are committed with it — a hook registered in settings.json but ignored here
# would be a setting that runs a file nobody else has.
.claude/*
!.claude/settings.json
!.claude/hooks/
web/tsconfig.tsbuildinfo
PLAN.full.md
# The packaging scripts are plain Python run directly, but importing one from a
# test leaves bytecode beside it. `check-publish-tree.sh` asserts that nothing
# untracked reaches the crate, so an unignored __pycache__ turns a passing tree
# into a failing one for no reason.
__pycache__/
*.pyc
